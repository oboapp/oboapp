{
  "name": "oboapp-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-firebase-messaging-sw.mjs",
    "dev": "next dev",
    "dev:emulator": "NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true next dev",
    "prebuild": "node scripts/generate-firebase-messaging-sw.mjs",
    "build": "next build",
    "prestart": "node scripts/generate-firebase-messaging-sw.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --config vitest.config.mts",
    "test:ui": "vitest --ui --config vitest.config.mts",
    "test:run": "vitest run --config vitest.config.mts",
    "test:coverage": "vitest run --config vitest.config.mts --coverage.enabled --coverage.provider=v8 --coverage.reporter=lcov --coverage.reporter=text",
    "crawl:rayon-oborishte": "pnpm --dir ../ingest run crawl --source rayon-oborishte-bg",
    "crawl:sofiyska-voda": "pnpm --dir ../ingest run crawl --source sofiyska-voda",
    "crawl:toplo": "pnpm --dir ../ingest run crawl --source toplo-bg",
    "crawl:sofia-bg": "pnpm --dir ../ingest run crawl --source sofia-bg",
    "ingest": "tsx lib/messageIngest/from-sources.ts",
    "notify": "tsx lib/notifications/match-and-notify.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@fontsource-variable/sofia-sans": "^5.2.8",
    "@google-cloud/storage": "^7.19.0",
    "@google/genai": "^1.33.0",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@oboapp/db": "workspace:*",
    "@oboapp/shared": "workspace:*",
    "@react-google-maps/api": "^2.20.7",
    "@sentry/nextjs": "^10.48.0",
    "@tanstack/react-query": "^5.108.1",
    "@turf/center": "^7.3.1",
    "@turf/helpers": "^7.3.4",
    "@turf/turf": "^7.3.1",
    "dotenv": "^17.2.3",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "openapi3-ts": "^4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "ua-parser-js": "^2.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.heat": "^0.2.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@types/ua-parser-js": "^0.7.39",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "4.0.18",
    "eslint-config-next": "^16.0.10",
    "happy-dom": "^20.0.11",
    "msw": "2.12.10",
    "playwright": "1.65.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "turndown": "^7.2.2",
    "typescript-eslint": "^8.54.0",
    "vitest": "4.0.18"
  },
  "optionalDependencies": {
    "lightningcss": "^1.30.2"
  }
}
