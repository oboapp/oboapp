# Cloud Workflow for Emergent Pipeline
# Terraform renders this template into the deployed workflow.
# Set matching emergent flags in source-jobs.<locality-id>.json and the catalog source definition.

main:
  steps:
    - init:
        assign:
          - project: '$${sys.get_env("GOOGLE_CLOUD_PROJECT_ID")}'
          - region: '$${sys.get_env("GOOGLE_CLOUD_LOCATION")}'
          - crawlers: ${jsonencode(crawler_job_names)}
    - crawlEmergent:
        parallel:
          concurrency_limit: 10
          for:
            value: crawler
            in: $${crawlers}
            steps:
              - callCrawler:
                  try:
                    call: http.post
                    args:
                      url: '$${"https://" + region + "-run.googleapis.com/apis/run.googleapis.com/v1/namespaces/" + project + "/jobs/crawl-" + crawler + ":run"}'
                      auth:
                        type: OAuth2
                  except:
                    as: e
                    steps:
                      - logCrawlerError:
                          call: sys.log
                          args:
                            text: '$${"Crawler " + crawler + " failed: " + string(e)}'
                            severity: "ERROR"
    - ingest:
        try:
          call: http.post
          args:
            url: '$${"https://" + region + "-run.googleapis.com/apis/run.googleapis.com/v1/namespaces/" + project + "/jobs/ingest-messages:run"}'
            auth:
              type: OAuth2
        except:
          as: e
          steps:
            - logIngestError:
                call: sys.log
                args:
                  text: '$${"Ingest failed: " + string(e)}'
                  severity: "ERROR"
    - notify:
        try:
          call: http.post
          args:
            url: '$${"https://" + region + "-run.googleapis.com/apis/run.googleapis.com/v1/namespaces/" + project + "/jobs/send-notifications:run"}'
            auth:
              type: OAuth2
        except:
          as: e
          steps:
            - logNotifyError:
                call: sys.log
                args:
                  text: '$${"Notify failed: " + string(e)}'
                  severity: "ERROR"
    - done:
        return: "completed"
